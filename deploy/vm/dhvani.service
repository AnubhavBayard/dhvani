[Unit]
Description=dhvani — voice RAG (HH Goa 2026 task 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@USER@
WorkingDirectory=@APP_DIR@
# Keys live here, root-owned 600, never in the repo and never in a .env the app
# reads — the deploy sets the environment, which is where they belong on a
# server (PROGRESS.md, 19 Aug).
EnvironmentFile=/etc/dhvani/env
Environment=DHVANI_INDEX_DIR=@INDEX_DIR@
Environment=DHVANI_ONNX_THREADS=2
Environment=PYTHONUNBUFFERED=1
# One worker: a second would load its own 1.7 GB FAISS index for throughput a
# demo will never use (DESIGN.md).
ExecStart=@APP_DIR@/.venv/bin/uvicorn dhvani.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
# The index load is ~4 s and the box is 8 GB; if it ever OOMs, restart rather
# than sit dead through a judging window.
OOMPolicy=restart

[Install]
WantedBy=multi-user.target
