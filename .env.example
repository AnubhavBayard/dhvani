# Copy to .env. Never commit .env — it is gitignored.
# Every key the project reads is listed here, with no values.

# --- Sarvam AI: STT (ADR-003) and generation (ADR-009), one key for both -----
SARVAM_API_KEY=

# --- ElevenLabs: second STTProvider, used by the provider-swap test (ADR-003)
ELEVENLABS_API_KEY=

# --- Groq: secondary generation provider, free-tier fallback (ADR-009) ------
GROQ_API_KEY=

# --- Hugging Face: dataset and model downloads at build time ----------------
# Optional. Unauthenticated downloads work but are rate-limited and slower.
HF_TOKEN=

# --- runtime ----------------------------------------------------------------
DHVANI_INDEX_DIR=index/full
DHVANI_STT_PROVIDER=sarvam           # sarvam | elevenlabs
DHVANI_GENERATION_PROVIDER=sarvam    # sarvam | groq
DHVANI_REPLAY_MODE=off               # off | record | replay (deterministic benchmarks)
DHVANI_ONNX_THREADS=2                # match the deploy box's vCPU count (ADR-010)
